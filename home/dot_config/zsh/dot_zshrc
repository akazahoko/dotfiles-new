# sources
source <(fzf --zsh)

# aliases
alias open="xdg-open"
alias ls="ls -v --color=auto"
alias ll="ls -lGAh --group-directories-first"

# autoload
autoload -Uz compinit && compinit
autoload -Uz colors && colors
autoload -Uz edit-command-line

# options
setopt append_history inc_append_history share_history
setopt autocd
setopt auto_menu menu_complete auto_param_slash
setopt no_case_glob no_case_match
setopt globdots extended_glob
setopt interactive_comments

export HISTFILE="$XDG_STATE_HOME/zsh_history"
export HISTSIZE=10000
export SAVEHIST=10000

# keybinds
bindkey '^?' backward-delete-char
bindkey '^H' backward-kill-word
bindkey '^K' history-search-backward
bindkey '^J' history-search-forward
bindkey '^R' fzf-history-widget

bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word

zle -N edit-command-line
bindkey '^X^E' edit-command-line

# yazi
open-yazi() {
    yazi <$TTY
    zle reset-prompt
}
zle -N open-yazi
bindkey '^F' open-yazi

# custom prompt
PROMPT="%B%F{green}%n%f%b in %B%F{blue}%~%f%b > "
RPROMPT="%B%F{red}%T%f%b"

# man
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p --color=always --pager \"less -RF\"'"

# fzf
export FZF_DEFAULT_OPTS="$FZF_DEFAULT_OPTS \
    --layout=reverse \
    --bind='alt-p:toggle-preview' \
    --bind='alt-j:down' \
    --bind='alt-k:up' \
    --preview='bat {}' \
    --preview-window=down:60% \
"

{
    "mpris": {
        "justify": "center",
        "format": "{title} - {artist}",
        "tooltip-format": "Title:\t{title}\nArtist:\t{artist}\nLength:\t{length}\nPlayer:\t{player}",
        "title-len": 35,
        "artist-len": 20,
        "player-icons": {
            "default": "▶",
            "mpv": "",
            "firefox": "",
            "audacious": "󰎇"
        },
        "status-icons": {
            "playing": "󰐊",
            "paused": "󰏤"
        }
    },
    "mpris#compact": {
        "format": "{status_icon}",
        "status-icons": {
            "playing": "󰐊",
            "paused": "󰏤"
        }
    }
}

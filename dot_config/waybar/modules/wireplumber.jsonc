{
    "wireplumber": {
        "format": "[VOL {volume}]",
        "foormat-icons": {
            "default": ["", "", "", ""]
        },
        "scroll-step": 1,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "Sink:\t{desc}\nVolume:\t{volume}%"
    }
}

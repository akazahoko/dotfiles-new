{
    "battery": {
        "format": "{icon}{capacity}%",
        "format-icons": {
            "default": [
                "󰂎",
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ],
            "charging": [
                "󰚥"
            ]
        },
        "tooltip-format": "Capacity:\t{capacity}%\nTime:\t\t{time}",
        "states": {
            "low": 20
        }
    }
}
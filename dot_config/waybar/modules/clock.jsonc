{
    "clock": {
        "interval": 30,
        "locale": "zh_HK.UTF-8",
        "format": "[{:L%b%d日 %A %H:%M}]",
        "justify": "center",
        "tooltip-format": "<span size='16pt' font='Iosevka Nerd Font Propo'>{calendar}</span>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "format": {
                "months": "{}",
                "days": "{}",
                "weekdays": "{}",
                "today": "<u>{}</u>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_down",
            "on-scroll-down": "shift_up"
        }
    }
}

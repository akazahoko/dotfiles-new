// https://github.com/Alexays/Waybar/wiki/Module:-Mango
{
    "mango/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "default": "󰨓",
            "active": "󰝤",
            "empty": "󰨕"
        },
        "on-click": "activate"
    },
    "mango/window": {
        "format": "{title}",
        "icon": true
    },
    "mango/layout": {
        "format-T": "TILE",
        "format-VT": "VTILE",
        "format-S": "SCROLL",
        "format-M": "MONO",
        "format-F": "FAIR",
        "format-CT": "CENTER"
    },
    "mango/keymode": {
        "format-default": "",
        "format-resize": "RESIZE",
        "format-monitor": "MONITOR",
        "format-float": "FLOAT"
    }
}

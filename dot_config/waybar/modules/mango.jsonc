// https://github.com/Alexays/Waybar/wiki/Module:-Mango
{
    "mango/workspaces": {
        "format": "{value}",
        "format-icons": {
            "default": "󰨓",
            "active": "󰝤",
            "empty": "󰨕"
        },
        "on-click": "activate"
    },
    "mango/window": {
        "format": "{title}",
        "icon": true
    },
    "mango/layout": {
        "format-T": "󰯌Tile",
        "format-S": "󰕫Scroll",
        "format-M": "󰹞Mono",
        "format-F": "󰕰Fair",
        "format-CT": "󰕬Center"
    },
    "mango/keymode": {
        "format-default": "",
        "format-resize": "󰩨Resize",
        "format-monitor": "󰍺Monitor",
        "format-float": "󰖲Float"
    }
}

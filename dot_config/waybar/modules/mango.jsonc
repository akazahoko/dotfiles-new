{
    "mango/workspaces": {
        "format": "{value}",
        "format-icons": {
            "default": "󰨓",
            "active": "󰝤",
            "empty": "󰨕"
        },
        "on-click": "activate"
    },
    "mango/window": {
        "format": "{app_id} >> {title}",
        "icon": false,
        "expand": true
    },
    "mango/layout": {
        "format-T": "[T]",
        "format-VT": "|T|",
        "format-S": "[S]",
        "format-M": "[M]",
        "format-F": "[F]",
        "format-CT": "[C]"
    },
    "mango/keymode": {
        "format-default": "",
        "format-resize": "[RESIZE]",
        "format-monitor": "[MONITOR]",
        "format-float": "[FLOAT]"
    }
}
